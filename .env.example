# External Video Generator only. Supported values are any provider label such as pika, kling or runway.
# Use mock only in automated tests; it is not a local video generator.
SPRITED_VIDEO_PROVIDER=kling
SPRITED_VIDEO_API_URL=https://api.example.com/v1/video/generations
SPRITED_VIDEO_API_KEY=
# Optional endpoint for asynchronous jobs. {id} is replaced with the provider job ID.
SPRITED_VIDEO_STATUS_URL_TEMPLATE=https://api.example.com/v1/video/generations/{id}
SPRITED_VIDEO_POLL_INTERVAL_MS=3000
SPRITED_VIDEO_MAX_POLL_ATTEMPTS=80

# Test-only: set only when SPRITED_VIDEO_PROVIDER=mock.
# SPRITED_MOCK_VIDEO_PATH=fixtures/sample.mp4
